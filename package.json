{
  "name": "vue-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.js --host 0.0.0.0",
    "build": "vite build --config web/vite.config.js",
    "start": "node --watch --watch-preserve-output server/index.js",
    "start:once": "node server/index.js --no-watch",
    "test:workflow": "node web/src/features/workflow/interpolation.test.js && node web/src/features/workflow/graph-placement.test.js && node web/src/features/talk/clock.test.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.12",
    "express": "^4.21",
    "marked": "^18.0.6",
    "vue": "^3.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0",
    "vite": "^6.0"
  }
}
